model CrewAssignment {
  id                 Int           @id @default(autoincrement())
  orgId              String        @default(dbgenerated("current_setting('app.current_org_id'::text)"))
  crew               Crew          @relation(fields: [crewId], references: [id])
  crewId             String
  customer           Customer      @relation(fields: [customerId], references: [id])
  customerId         String
  jobType            JobType       @relation(fields: [jobTypeId], references: [id])
  jobTypeId          Int
  tenantOrganization Organization? @relation(fields: [orgId], references: [id])
}

model Notification {
  id               String   @id @default(uuid())
  orgId            String   @default(dbgenerated("current_setting('app.current_org_id'::text)"))
  type             String?
  jobId            String?
  jobTechReference String?
  receiverType     String?
  triggeredBy      String?
  title            String?
  description      String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  tenantOrganization Organization?      @relation(fields: [orgId], references: [id])
  notificationUser   NotificationUser[]
  job                Job?               @relation(fields: [jobId], references: [id])
}

model NotificationUser {
  id             String    @id @default(uuid())
  notificationId String
  userId         Int
  orgId          String    @default(dbgenerated("current_setting('app.current_org_id'::text)"))
  isRead         Boolean   @default(false)
  isCleared      Boolean   @default(false)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime? @updatedAt @db.Timestamptz(3)

  notification       Notification  @relation(fields: [notificationId], references: [id])
  user               User          @relation(fields: [userId], references: [id])
  tenantOrganization Organization? @relation(fields: [orgId], references: [id])
}

model JobLock {
  id        String    @id
  type      String
  status    String
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
}

model InsightsJobStatus {
  id                Int                 @id @default(autoincrement())
  code              String
  desc              String
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime?           @updatedAt @db.Timestamptz(3)
  isDeleted         Boolean             @default(false)
  InsightsJobHeader InsightsJobHeader[]
  InsightsJobDetail InsightsJobDetail[]
}

model InsightsJobHeader {
  id                  Int                 @id @default(autoincrement())
  insightsJobStatus   InsightsJobStatus   @relation(fields: [insightsJobStatusId], references: [id])
  insightsJobStatusId Int
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime?           @updatedAt @db.Timestamptz(3)
  isDeleted           Boolean             @default(false)
  InsightsJobDetail   InsightsJobDetail[]
}

model InsightsJobDetail {
  id                  Int               @id @default(autoincrement())
  insightsJobHeader   InsightsJobHeader @relation(fields: [insightsJobHeaderId], references: [id])
  insightsJobHeaderId Int
  insightsJobStatus   InsightsJobStatus @relation(fields: [insightsJobStatusId], references: [id])
  insightsJobStatusId Int
  user                User              @relation(fields: [adminUserId], references: [id])
  organization        Organization      @relation(fields: [orgId], references: [id])
  adminUserId         Int
  orgId               String
  failureDate         DateTime?         @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime?         @updatedAt @db.Timestamptz(3)
  isDeleted           Boolean           @default(false)
}

model OrganizationSetting {
  id                      Int                       @id @default(autoincrement())
  orgId                   String                    @default(dbgenerated("current_setting('app.current_org_id'::text)"))
  organization            Organization              @relation(fields: [orgId], references: [id])
  paymentInstructions     String?
  companyLogoS3Key        String?
  invoiceMessage          String?
  companyName             String?
  phoneNumber             String?
  address                 String?
  invoiceEmail            String?
  createdAt               DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime?                 @updatedAt @db.Timestamptz(3)
  isDeleted               Boolean                   @default(false)
  quickbooksEnabled       Boolean                   @default(false)
  OrganizationCustomField OrganizationCustomField[]
  organizationTaxRate     OrganizationTaxRate[]
  timezone                String?
}

model OrganizationCustomFieldCategory {
  id                      Int                       @id @default(autoincrement())
  code                    String
  desc                    String
  createdAt               DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime?                 @updatedAt @db.Timestamptz(3)
  isDeleted               Boolean                   @default(false)
  OrganizationCustomField OrganizationCustomField[]
}

model OrganizationCustomField {
  id                                Int       @id @default(autoincrement())
  orgId                             String    @default(dbgenerated("current_setting('app.current_org_id'::text)"))
  organizationSettingId             Int
  organizationCustomFieldCategoryId Int
  name                              String
  createdAt                         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                         DateTime? @updatedAt @db.Timestamptz(3)
  isInvoiceable                     Boolean   @default(false)
  showCrew                          Boolean   @default(false)
  showCustomer                      Boolean   @default(false)
  isActive                          Boolean   @default(false)
  isDeleted                         Boolean   @default(false)

  organization                    Organization                    @relation(fields: [orgId], references: [id])
  organizationSetting             OrganizationSetting             @relation(fields: [organizationSettingId], references: [id])
  organizationCustomFieldCategory OrganizationCustomFieldCategory @relation(fields: [organizationCustomFieldCategoryId], references: [id])
  OrganizationJobCustomField      OrganizationJobCustomField[]
}

model OrganizationTaxRate {
  id                    Int       @id @default(autoincrement())
  orgId                 String    @default(dbgenerated("current_setting('app.current_org_id'::text)"))
  organizationSettingId Int
  name                  String
  taxRatePercent        Float
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime? @updatedAt @db.Timestamptz(3)

  organization        Organization        @relation(fields: [orgId], references: [id])
  organizationSetting OrganizationSetting @relation(fields: [organizationSettingId], references: [id])
  JobSubType          JobSubType[]
}

model OrganizationJobCustomField {
  id                        Int                     @id @default(autoincrement())
  orgId                     String                  @default(dbgenerated("current_setting('app.current_org_id'::text)"))
  organization              Organization            @relation(fields: [orgId], references: [id])
  organizationCustomFieldId Int
  organizationCustomField   OrganizationCustomField @relation(fields: [organizationCustomFieldId], references: [id])
  jobId                     String
  value                     String
  createdAt                 DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime?               @updatedAt @db.Timestamptz(3)
  isDeleted                 Boolean                 @default(false)
  job                       Job                     @relation(fields: [jobId], references: [id])
}

model Project {
  id                 String  @id @default(uuid())
  orgId              String  @default(dbgenerated("current_setting('app.current_org_id'::text)"))
  customerId         String
  locationId         String
  name               String
  billingNotes       String?
  billingEmail       String?
  accountingSoftware String?
  primaryContactId   String?
  secondaryContactId String?
  isActive           Boolean @default(false)

  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime?    @updatedAt @db.Timestamptz(3)
  isDeleted        Boolean      @default(false)
  customer         Customer     @relation(fields: [customerId], references: [id])
  location         Location     @relation(fields: [locationId], references: [id])
  primaryContact   Contact?     @relation("PrimaryContact", fields: [primaryContactId], references: [id])
  secondaryContact Contact?     @relation("SecondaryContact", fields: [secondaryContactId], references: [id])
  organization     Organization @relation(fields: [orgId], references: [id])
  Job              Job[]
  Booking          Booking[]
}

model QBIntegrationTokens {
  id            String    @id @default(uuid())
  orgId         String    @unique
  companyId     String
  refreshToken  String
  accessToken   String?
  tokensExpired Boolean   @default(false)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime? @updatedAt @db.Timestamptz(3)
}

