{
  "name": "backend-api-app",
  "version": "1.0.0",
  "description": "A backend app (API) for Scrap-It",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon",
    "test": "jest",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:seed:production": "node --loader ts-node/esm ./prisma/seeders/seed.production.ts",
    "db:reset": "prisma migrate reset",
    "format": "prettier --check --ignore-path .gitignore .",
    "format:fix": "prettier --write --ignore-path .gitignore ."
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts",
    "exec": "ts-node src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scrap-it/backend-api-app-2.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/scrap-it/backend-api-app-2.0/issues"
  },
  "homepage": "https://github.com/scrap-it/backend-api-app-2.0#readme",
  "devDependencies": {
    "@faker-js/faker": "^7.3.0",
    "@types/auth0": "^3.3.4",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/express-jwt": "^6.0.4",
    "@types/jest": "^27.5.1",
    "@types/morgan": "^1.9.3",
    "@types/node": "^17.0.35",
    "@types/node-schedule": "^2.1.0",
    "dotenv": "^16.0.1",
    "eslint": "^8.16.0",
    "eslint-config-prettier": "^8.5.0",
    "jest": "^28.1.0",
    "jest-mock-extended": "^2.0.6",
    "nodemon": "^2.0.16",
    "prettier": "^2.6.2",
    "prisma": "^4.16.2",
    "ts-jest": "^28.0.3",
    "ts-node": "^10.8.0",
    "typescript": "^4.7.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.99.0",
    "@prisma/client": "^4.16.2",
    "@sendgrid/client": "^7.7.0",
    "@sendgrid/mail": "^7.7.0",
    "@types/lodash": "^4.14.186",
    "@types/luxon": "^3.3.0",
    "@types/md5": "^2.3.2",
    "@types/multer": "^1.4.7",
    "@types/multer-s3": "^3.0.0",
    "adm-zip": "^0.5.10",
    "auth0": "^3.7.0",
    "axios": "^0.27.2",
    "body-parser": "^1.20.0",
    "cors": "^2.8.5",
    "expo-server-sdk": "^3.7.0",
    "express": "^4.18.1",
    "express-jwt": "^7.7.5",
    "express-validator": "^6.14.1",
    "intuit-oauth": "^4.0.0",
    "jwks-rsa": "^2.1.3",
    "lodash": "^4.17.21",
    "md5": "^2.3.0",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.43",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "node-schedule": "^2.1.1",
    "pg": "^8.7.3",
    "puppeteer": "^21.3.8",
    "twilio": "^3.77.2"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} ./prisma/seeders/seed.ts"
  }
}
